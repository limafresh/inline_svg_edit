<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>SVG from HTML input</name>
    <id>com.github.limafresh.inline_svg_edit.svg_from_html_input</id>
    <param name="svg_id" type="string" gui-text="SVG id: "></param>
    <input>
        <extension>.html</extension>
        <mimetype>text/html</mimetype>
        <filetypename>SVG from HTML file (*.html)</filetypename>
        <filetypetooltip>Open SVG from HTML files</filetypetooltip>
    </input>
    <script>
        <command location="inx" interpreter="python">svg_from_html_input.py</command>
    </script>
</inkscape-extension>
